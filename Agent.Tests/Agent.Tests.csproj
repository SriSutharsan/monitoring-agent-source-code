<Project Sdk="Microsoft.NET.Sdk">
  <!--
    xUnit tests for the agent. The collectors, sync engine, configuration and storage are exercised through fakes of the
    platform interfaces (IWmiClient, IRegistryReader, ...), so every test runs on any machine. Tests that talk HTTP use the
    in-process Agent.MockApi server on a free loopback port. Run with: dotnet test
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Agent.Tests</RootNamespace>
    <AssemblyName>Agent.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agent.Models\Agent.Models.csproj" />
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
    <ProjectReference Include="..\Agent.Configuration\Agent.Configuration.csproj" />
    <ProjectReference Include="..\Agent.Logging\Agent.Logging.csproj" />
    <ProjectReference Include="..\Agent.Storage\Agent.Storage.csproj" />
    <ProjectReference Include="..\Agent.Communication\Agent.Communication.csproj" />
    <ProjectReference Include="..\Agent.Collectors\Agent.Collectors.csproj" />
    <ProjectReference Include="..\Tools\MockApi\Agent.MockApi.csproj" />
  </ItemGroup>
</Project>
